# All variables are optional. The portal runs fully offline without any of them —
# only the AI Copilot needs configuration.

# Enables the AI Copilot. Without it, /api/chat returns an offline message and every
# rule, table and calculation still works.
GEMINI_API_KEY=""

# Optional: override the model id used by /api/chat.
GEMINI_MODEL="gemini-3.8-flash"

# Optional: server port (default 3000).
PORT="3000"
